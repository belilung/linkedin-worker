# Скопируй этот файл в .env и вставь свой ключ:
#   cp .env.example .env

# Anthropic API key — получи на https://console.anthropic.com/settings/keys
# Нужен для генерации сообщений и комментариев через Claude.
# Минимальный баланс: $5.
ANTHROPIC_API_KEY=

# (Опционально) Использовать Claude Code CLI вместо API.
# Раскомментируй, если у тебя установлен Claude Code и есть Max/Pro подписка.
# USE_CLAUDE_CLI=1
